+    backgroundColor: 'rgba(0,0,0,0.16)',
+  },
+  fallbackVisual: {
+    ...StyleSheet.absoluteFillObject,
+    alignItems: 'center',
+    justifyContent: 'center',
+    gap: 18,
+    opacity: 0.88,
+  },
+  fallbackIcon: {
+    width: 82,
