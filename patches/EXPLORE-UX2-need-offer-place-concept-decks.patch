+    overflow: 'hidden',
+    padding: POSTER_CARD_GEOMETRY.contentInset,
+    justifyContent: 'space-between',
+  },
+  image: {
+    ...StyleSheet.absoluteFillObject,
+  },
+  imageScrim: {
