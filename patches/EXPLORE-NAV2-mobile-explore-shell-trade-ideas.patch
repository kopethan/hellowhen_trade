@@ -0,0 +1,126 @@
+import React, { useMemo, useState } from 'react';
+import { Pressable, ScrollView, StyleSheet, View, useWindowDimensions } from 'react-native';
+import { useNavigation } from '@react-navigation/native';
+import type { NativeStackNavigationProp } from '@react-navigation/native-stack';
+import { AppFixedHeaderScreen } from '../../components/AppFixedHeaderScreen';
+import { AppHeaderActionButton } from '../../components/AppHeaderActionButton';
+import { AppText } from '../../components/AppText';
+import { MobileIcon } from '../../components/MobileIcon';
+import type { RootStackParamList } from '../../navigation/RootNavigator';
+import { useThemeTokens } from '../../providers/ThemeProvider';
+import { useTranslation } from '../../providers/MobileI18nProvider';
+import { TradeFeedIdeaCard } from '../trade/TradeDeckFeedScreen';
+import { feedTradeIdeaKeys, feedTradeIdeas, type FeedTradeIdeaKey } from '../trade/tradeFeedIdeas';
+import { getMobileTradeDeckCardSize } from '../trade/components/tradeDeckGeometry';
+
+const tradeExploreIdeaKeys = feedTradeIdeaKeys.filter((ideaKey) => feedTradeIdeas[ideaKey].type === 'trade') as readonly FeedTradeIdeaKey[];
+
+export function ExploreScreen() {
+  const navigation = useNavigation<NativeStackNavigationProp<RootStackParamList>>();
+  const theme = useThemeTokens();
+  const { t } = useTranslation();
+  const { width } = useWindowDimensions();
+  const [activeIdeaIndex, setActiveIdeaIndex] = useState(0);
+  const cardSize = getMobileTradeDeckCardSize(width);
+  const ideaKeys = useMemo(() => tradeExploreIdeaKeys, []);
+  const activeIdeaKey = ideaKeys[activeIdeaIndex] ?? ideaKeys[0];
+
+  function moveIdea(direction: -1 | 1) {
+    setActiveIdeaIndex((current) => {
+      if (!ideaKeys.length) return 0;
+      return (current + direction + ideaKeys.length) % ideaKeys.length;
+    });
+  }
+
+  const header = (
+    <View style={styles.headerRow}>
+      <AppText accessibilityRole="header" style={styles.title}>{t('navigation.tabs.explore')}</AppText>
+      <AppHeaderActionButton
+        icon="profile"
+        accessibilityLabel={t('navigation.routes.account')}
+        onPress={() => navigation.navigate('Account')}
+      />
+    </View>
+  );
+
+  return (
+    <AppFixedHeaderScreen header={header}>
+      <ScrollView contentContainerStyle={styles.content} showsVerticalScrollIndicator={false}>
+        <View style={styles.section}>
+          <View style={styles.sectionHeader}>
+            <AppText style={styles.sectionTitle}>{t('trade.feedIdeas.badge')}</AppText>
+            <AppText style={[styles.sectionCount, { color: theme.color.muted }]}>{ideaKeys.length}</AppText>
+          </View>
+
+          {activeIdeaKey ? (
+            <>
+              <View style={[styles.deckStage, { width: cardSize, height: cardSize + 20 }]}>
+                <View
+                  pointerEvents="none"
+                  style={[
+                    styles.deckBackCard,
+                    styles.deckBackCardFar,
+                    { backgroundColor: theme.color.subtleSurface, borderColor: theme.color.border },
+                  ]}
+                />
+                <View
+                  pointerEvents="none"
+                  style={[
+                    styles.deckBackCard,
+                    styles.deckBackCardNear,
+                    { backgroundColor: theme.color.surface, borderColor: theme.color.border },
+                  ]}
+                />
+                <View style={styles.deckFrontCard}>
+                  <TradeFeedIdeaCard
+                    ideaKey={activeIdeaKey}
+                    onOpenIdea={(ideaKey) => navigation.navigate('TradeIdeaDetail', { ideaId: ideaKey })}
+                  />
+                </View>
+              </View>
+
+              <View style={[styles.deckControls, { width: cardSize }]}>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel={t('common.actions.previousCard')}
+                  onPress={() => moveIdea(-1)}
+                  style={({ pressed }) => [styles.deckButton, { backgroundColor: theme.color.surface, borderColor: theme.color.border }, pressed && styles.pressed]}
+                >
+                  <MobileIcon name="deck-back" size={18} color={theme.color.text} decorative />
+                </Pressable>
+                <AppText style={[styles.deckPosition, { color: theme.color.muted }]}>{activeIdeaIndex + 1} / {ideaKeys.length}</AppText>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel={t('common.actions.nextCard')}
+                  onPress={() => moveIdea(1)}
+                  style={({ pressed }) => [styles.deckButton, { backgroundColor: theme.color.surface, borderColor: theme.color.border }, pressed && styles.pressed]}
+                >
+                  <MobileIcon name="deck-advance" size={18} color={theme.color.text} decorative />
+                </Pressable>
+              </View>
+            </>
+          ) : null}
+        </View>
+      </ScrollView>
+    </AppFixedHeaderScreen>
+  );
+}
+
+const styles = StyleSheet.create({
+  headerRow: { minHeight: 44, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', gap: 12 },
+  title: { flex: 1, minWidth: 0, fontSize: 24, lineHeight: 30, fontWeight: '900', letterSpacing: -0.45 },
+  content: { paddingTop: 8, paddingBottom: 34 },
+  section: { gap: 14 },
+  sectionHeader: { flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between', gap: 12 },
+  sectionTitle: { fontSize: 18, lineHeight: 23, fontWeight: '900', letterSpacing: -0.25 },
+  sectionCount: { fontSize: 12, lineHeight: 16, fontWeight: '800' },
+  deckStage: { alignSelf: 'center', position: 'relative' },
+  deckBackCard: { position: 'absolute', top: 0, left: 0, width: '100%', aspectRatio: 1, borderRadius: 28, borderWidth: StyleSheet.hairlineWidth },
+  deckBackCardFar: { transform: [{ translateY: 16 }, { scale: 0.94 }], opacity: 0.62 },
+  deckBackCardNear: { transform: [{ translateY: 8 }, { scale: 0.97 }], opacity: 0.86 },
+  deckFrontCard: { position: 'absolute', top: 0, left: 0 },
+  deckControls: { alignSelf: 'center', minHeight: 44, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 4 },
+  deckButton: { width: 44, height: 44, borderRadius: 22, borderWidth: 1, alignItems: 'center', justifyContent: 'center' },
+  deckPosition: { fontSize: 12, lineHeight: 16, fontWeight: '800', fontVariant: ['tabular-nums'] },
+  pressed: { opacity: 0.76, transform: [{ scale: 0.98 }] },
+});
