diff --git a/apps/mobile/src/features/explore/ExploreNavigator.tsx b/apps/mobile/src/features/explore/ExploreNavigator.tsx
new file mode 100644
index 0000000..06b3ecb
--- /dev/null
+++ b/apps/mobile/src/features/explore/ExploreNavigator.tsx
@@ -0,0 +1,26 @@
+import React from 'react';
+import { createNativeStackNavigator } from '@react-navigation/native-stack';
+import { betaFeatures } from '../../lib/betaFeatures';
+import { ExploreNeedIdeaDetailScreen, ExploreOfferIdeaDetailScreen } from './ExploreInventoryIdeaDetailScreen';
+import { ExploreScreen } from './ExploreScreen';
+import { HellowhenPlaceDetailScreen } from './HellowhenPlaceDetailScreen';
+
+export type ExploreStackParamList = {
+  ExploreHome: undefined;
+  NeedIdeaDetail: { templateId: string; title?: string };
+  OfferIdeaDetail: { templateId: string; title?: string };
+  HellowhenPlaceDetail: { placeId: string; title?: string };
+};
+
+const ExploreStack = createNativeStackNavigator<ExploreStackParamList>();
+
+export function ExploreNavigator() {
+  return (
+    <ExploreStack.Navigator initialRouteName="ExploreHome" screenOptions={{ headerShown: false }}>
+      <ExploreStack.Screen name="ExploreHome" component={ExploreScreen} />
+      <ExploreStack.Screen name="NeedIdeaDetail" component={ExploreNeedIdeaDetailScreen} />
+      <ExploreStack.Screen name="OfferIdeaDetail" component={ExploreOfferIdeaDetailScreen} />
+      {betaFeatures.plansEnabled ? <ExploreStack.Screen name="HellowhenPlaceDetail" component={HellowhenPlaceDetailScreen} /> : null}
+    </ExploreStack.Navigator>
+  );
+}
