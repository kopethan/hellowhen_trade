{
  "name": "hellowhen",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @hellowhen/api",
    "dev:web": "npm run dev -w @hellowhen/web",
    "dev:mobile": "npm run start -w @hellowhen/mobile",
    "stop:dev": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run prisma:generate && npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema apps/api/prisma/schema.prisma",
    "seed:plus-test-user": "tsx apps/api/prisma/seed-plus-test-user.ts",
    "admin:smoke": "node scripts/admin-launch-smoke.mjs",
    "admin:rehearsal": "node scripts/admin-launch-smoke.mjs",
    "plans:smoke": "node scripts/plans-hidden-smoke.mjs",
    "business:hidden-smoke": "node scripts/business-hidden-smoke.mjs",
    "mobile:launch-smoke": "node scripts/mobile-launch-smoke.mjs",
    "build:packages": "npm run build -w @hellowhen/contracts && npm run build -w @hellowhen/api-client && npm run build -w @hellowhen/i18n && npm run build -w @hellowhen/shared && npm run build -w @hellowhen/theme && npm run build -w @hellowhen/trade-domain && npm run build -w @hellowhen/ui",
    "build:apps": "npm run build -w @hellowhen/api && npm run build -w @hellowhen/web",
    "mobile:store-readiness": "npm run mobile:launch-smoke && npm run mobile:store-release-smoke && npm run mobile:app-review-smoke && npm run app-update:safety && npm run mobile:release-preflight && npm run mobile:submission-preflight && npm run store:copy-scan && npm run mobile:ugc-safety-smoke && npm run account-deletion:safety-smoke && node scripts/mobile-store-readiness.mjs && npm run cash-promise:safety-smoke",
    "cash-promise:safety-smoke": "node scripts/cash-promise-safety-smoke.mjs",
    "starter-library:qa": "node scripts/starter-library-qa.mjs",
    "places:smoke": "node scripts/place-library-hidden-smoke.mjs",
    "media:cdn-smoke": "node scripts/media-cdn-smoke.mjs",
    "language:audit": "node scripts/language-consistency-audit.mjs",
    "media:variants-smoke": "node scripts/media-variants-smoke.mjs",
    "media:s3-cleanup-smoke": "node scripts/media-s3-cleanup-smoke.mjs",
    "media:s3-migrate": "npm run media:s3-migrate -w @hellowhen/api --",
    "places:address-audit": "npm run places:address-cleanup -w @hellowhen/api -- --dry-run",
    "places:address-cleanup": "npm run places:address-cleanup -w @hellowhen/api --",
    "places:address-provider-smoke": "node scripts/place-address-provider-smoke.mjs",
    "plans:test": "npm run test:plans -w @hellowhen/api",
    "mobile:store-release-smoke": "node scripts/mobile-store-release-smoke.mjs",
    "mobile:app-review-smoke": "node scripts/mobile-app-review-smoke.mjs",
    "mobile:ugc-safety-smoke": "node scripts/mobile-ugc-safety-smoke.mjs",
    "store:copy-scan": "node scripts/store-visible-copy-scan.mjs",
    "mobile:release-preflight": "node scripts/mobile-release-preflight.mjs",
    "mobile:submission-preflight": "node scripts/mobile-submission-preflight.mjs",
    "app-update:policy-test": "npm run test:mobile-release -w @hellowhen/api",
    "app-update:native-test": "npm run typecheck:tests -w @hellowhen/mobile && tsx --test apps/mobile/src/features/app-update/__tests__/appUpdatePolicy.test.ts apps/mobile/src/features/app-update/__tests__/appUpdateStore.test.ts",
    "app-update:rollout-smoke": "node scripts/app-update-rollout-smoke.mjs",
    "app-update:probe": "node scripts/app-update-policy-probe.mjs",
    "app-update:safety": "npm run build -w @hellowhen/contracts && npm run app-update:policy-test && npm run app-update:native-test && npm run app-update:rollout-smoke",
    "places:library-seed": "npm run places:library-seed -w @hellowhen/api --",
    "account-deletion:test": "npm run test:account-deletion -w @hellowhen/api",
    "account-deletion:safety-smoke": "node scripts/account-deletion-lifecycle-smoke.mjs",
    "account-deletion:process-due": "npm run account-deletion:process-due -w @hellowhen/api",
    "account-deletion:accelerated-smoke": "node scripts/account-deletion-accelerated-smoke.mjs",
    "web:auth-isolation-smoke": "node scripts/web-auth-isolation-smoke.mjs",
    "web:navigation-parity-smoke": "node scripts/web-navigation-parity-smoke.mjs",
    "web:explore-parity-smoke": "node scripts/web-explore-parity-smoke.mjs",
    "web:account-header-parity-smoke": "node scripts/web-account-header-parity-smoke.mjs",
    "web:header-ownership-smoke": "node scripts/web-header-ownership-smoke.mjs",
    "web:explore-return-context-smoke": "node scripts/web-explore-return-context-smoke.mjs",
    "web:plan-place-i18n-smoke": "node scripts/web-plan-place-i18n-smoke.mjs",
    "web:onboarding-explore-era-smoke": "node scripts/web-onboarding-explore-era-smoke.mjs",
    "web:runtime-responsive-smoke": "node scripts/web-runtime-responsive-smoke.mjs"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.4.5",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx apps/api/prisma/seed.ts"
  }
}
